    "a=int(input(\"Enter number to be checked:\"))\n",
    "if a>0:\n",
    "    print(\"The number\",a,\"is positive\")\n",
    "elif a<0:\n",
    "    print(\"The number\",a,\"is negative\")\n",
    "elif a==0:\n",
    "    print(\"The number\",a,\"is zero\")\n",
    "else:\n",
    "    print(\"Invalid input\")"
   ]
